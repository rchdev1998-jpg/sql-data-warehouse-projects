/*
=======================
GOLD LAYER : CREATE VIEW
=======================
Purpose:
		To create business ready data for data analytics, data reports.
*/


CREATE VIEW gold.fact_sales AS
select 
soi.order_item_id,
sp.product_name,
soi.price_usd,
soi.cogs_usd
from silver.order_items soi
left join silver.products sp
on sp.prodcut_id = soi.product_id
left join silver.orders so
on so.order_id = soi.order_id


CREATE VIEW gold.refund_item AS
select
p.product_name,
p.created_at,
oi.price_usd
from silver.order_item_refunds oir
left join silver.order_items oi
on oi.order_item_id = oir.order_item_id
left join silver.products p
on p.prodcut_id = p.prodcut_id


CREATE VIEW gold.website_session AS
select
ws.device_type,
ws.http_referer,
wp.pageview_url,
wp.created_at
from silver.website_sessions ws
left join silver.website_pageviews wp
on wp.website_session_id = ws.website_session_id
